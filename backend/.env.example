
# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE=sementes

# JWT (obrigatórias: a aplicação não sobe sem elas)
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# App
PORT=3333
NODE_ENV=development

# Sessão: em produção não defina esta variável, para o cookie sair como Secure.
COOKIE_SECURE=false

# Documentação em /docs (desligada se não for "true")
ENABLE_SWAGGER=true

# Primeiro administrador, usado só pelos seeds (senha com pelo menos 12 caracteres)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
